#!/bin/sh
set -eu
policy_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
index_dir=$(mktemp -d)
trap 'rm -rf "$index_dir"' EXIT HUP INT TERM
# Git passes the remote name first. Without it, check full history (strictest).
remote_name=${1:-}
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/*|refs/tags/*) ;;
        *) echo 'Only reviewed branch and tag namespaces may be published.' >&2; exit 1 ;;
    esac
    case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
    git rev-parse --verify "$local_sha^{commit}" >/dev/null
    # Check newly reachable ancestors too: a clean tip can still publish old data.
    # A new ref skips only commits this remote already has, per local remote-tracking
    # refs (fetch first); stale refs make the check stricter, never weaker.
    case "$remote_sha" in
        0000000000000000000000000000000000000000)
            if [ -n "$remote_name" ]; then
                commits=$(git rev-list "$local_sha" --not --remotes="$remote_name")
            else
                commits=$(git rev-list "$local_sha")
            fi
            ;;
        *) commits=$(git rev-list "$remote_sha..$local_sha") ;;
    esac
    for commit in $commits; do
        GIT_INDEX_FILE="$index_dir/index" git read-tree "$commit^{tree}"
        GIT_INDEX_FILE="$index_dir/index" python3 "$policy_root/scripts/check_publication.py"
    done
    if [ -n "$commits" ]; then
        command -v gitleaks >/dev/null 2>&1 || { echo "Install Gitleaks before pushing." >&2; exit 1; }
        gitleaks git --redact --no-banner --no-color --log-opts="$local_sha" "$(git rev-parse --show-toplevel)"
    fi
done
